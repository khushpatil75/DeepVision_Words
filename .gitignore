.env
.env.*
*.env
secrets.py

# --- Jupyter Notebook Checkpoints ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# --- Training Checkpoints (intermediate, not the final deployed model) ---
# The final trained model (hybrid_ctc_model.pth) and vocabulary
# (ctc_vocab.json) are REQUIRED to run the project and are tracked.
# Only intermediate/emergency checkpoints generated during training
# are excluded here.
hybrid_ctc_model_checkpoint.pth
interrupted_checkpoint.pth
error_checkpoint.pth

# --- Generated Training Outputs (can be reproduced by re-running notebooks) ---
loss_convergence_graph.png

# --- Logs ---
*.log
logs/

